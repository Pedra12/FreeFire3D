config_version=5

[application]
config/name="FreeFire3D - Clocktower 4v4"
config/icon="res://icon.svg"
run/main_scene="res://scenes/character_select.tscn"

[autoload]
MatchConfig="*res://scripts/match_config.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=3
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.105, 1)
textures/default_filters/use_nearest_mipmap_filter=true
textures/vram_compression/import_etc2_astc=true

[physics]
3d/default_gravity=9.8
